<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_legacy_import_batch_list" model="ir.ui.view">
        <field name="name">account.legacy.import.batch.list</field>
        <field name="model">account.legacy.import.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes de migración" multi_edit="1">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="source_filename"/>
                <field name="source_sheet" optional="show"/>
                <field name="source_sha256" optional="show"/>
                <field name="source_move_count" optional="show"/>
                <field name="source_line_count" optional="show"/>
                <field name="source_debit_total" optional="show" sum="Debe"/>
                <field name="source_credit_total" optional="show" sum="Haber"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="prepared_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_account_legacy_import_batch_form" model="ir.ui.view">
        <field name="name">account.legacy.import.batch.form</field>
        <field name="model">account.legacy.import.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de migración">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="prepared_at"/>
                        </group>
                        <group>
                            <field name="source_filename"/>
                            <field name="source_sheet"/>
                            <field name="source_size"/>
                        </group>
                    </group>
                    <group string="Identidad del archivo">
                        <field name="source_sha256"/>
                    </group>
                    <group string="Controles del lote">
                        <group>
                            <field name="source_move_count"/>
                            <field name="source_line_count"/>
                        </group>
                        <group>
                            <field name="source_debit_total"/>
                            <field name="source_credit_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asientos migrados">
                            <field name="move_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="ref"/>
                                    <field name="journal_id"/>
                                    <field name="x_legacy_key"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notes" placeholder="Decisiones o excepciones aplicadas al lote..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_legacy_import_batch_search" model="ir.ui.view">
        <field name="name">account.legacy.import.batch.search</field>
        <field name="model">account.legacy.import.batch</field>
        <field name="arch" type="xml">
            <search string="Lotes de migración">
                <field name="name"/>
                <field name="source_filename"/>
                <field name="source_sha256"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group>
                    <filter string="Empresa" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Archivo" name="group_by_file" context="{'group_by': 'source_filename'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_legacy_import_batch" model="ir.actions.act_window">
        <field name="name">Lotes de migración</field>
        <field name="res_model">account.legacy.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_account_legacy_import_batch"
        name="Lotes de migración"
        parent="account.account_account_menu"
        action="action_account_legacy_import_batch"
        groups="account.group_account_manager"
        sequence="95"
    />
</odoo>
