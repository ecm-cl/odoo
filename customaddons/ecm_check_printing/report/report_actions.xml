<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vsg_check" model="ir.actions.report">
        <field name="name">Cheque</field>
        <field name="model">l10n_latam.check</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ecm_check_printing.report_vsg_check</field>
        <field name="report_file">ecm_check_printing.report_vsg_check</field>
        <field name="paperformat_id" ref="paperformat_vsg_check"/>
        <field name="print_report_name">'Cheque - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="l10n_latam_check.model_l10n_latam_check"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_vsg_check_calibration" model="ir.actions.report">
        <field name="name">Cheque: grilla de calibracion</field>
        <field name="model">account.journal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ecm_check_printing.report_vsg_check_calibration</field>
        <field name="report_file">ecm_check_printing.report_vsg_check_calibration</field>
        <field name="paperformat_id" ref="paperformat_vsg_check"/>
        <field name="print_report_name">'Calibracion cheque - %s' % (object.name or '')</field>
    </record>
</odoo>
