<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La hoja, no el cheque. El cheque va apoyado en una esquina de esta
         hoja; donde exactamente lo dice el diario (Hoja: posición X / Y).
         Se compagina horizontal, que es como están medidas las coordenadas,
         y la página se gira un cuarto de vuelta al generar el PDF para que
         entre a la impresora por el lado corto, igual que con Flex.
         El tamaño declarado aquí es un entero en milímetros y va un poco
         holgado a propósito: al girar la página se le fija el MediaBox a la
         medida exacta del diario, anclado en la esquina superior izquierda. -->
    <record id="paperformat_vsg_check" model="report.paperformat">
        <field name="name">Hoja de cheque (76,2 x 160 mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">161</field>
        <field name="page_height">77</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <!-- sin esto wkhtmltopdf encoge el contenido (~0.82) y las posiciones
             en milímetros dejan de corresponder con el papel -->
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- Para calibrar: la misma impresión sobre una hoja carta, que es lo que
         se pone a contraluz contra un cheque real. El contenido queda apoyado
         en la esquina superior izquierda de la hoja, sin girar. -->
    <record id="paperformat_vsg_check_letter" model="report.paperformat">
        <field name="name">Hoja de cheque: carta (calibración)</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>
</odoo>
