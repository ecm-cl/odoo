<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vsg_check_print_wizard_form" model="ir.ui.view">
        <field name="name">vsg.check.print.wizard.form</field>
        <field name="model">vsg.check.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir cheque">
                <field name="check_ids" invisible="1"/>
                <group>
                    <field name="endorsement" widget="radio"/>
                </group>
                <group>
                    <field name="crossed"/>
                    <field name="year_prefix"/>
                    <field name="sheet"/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimir"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
