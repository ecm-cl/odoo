<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_latam_check_view_form_vsg" model="ir.ui.view">
        <field name="name">l10n_latam.check.form.vsg</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_void']" position="before">
                <field name="payment_method_code" invisible="1"/>
                <button name="action_vsg_print_check"
                        string="Imprimir cheque"
                        type="object"
                        class="btn-primary"
                        invisible="payment_method_code != 'own_checks'"/>
            </xpath>
        </field>
    </record>
</odoo>
