<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_vsg_check" model="ir.ui.view">
        <field name="name">account.payment.form.vsg.check</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_vsg_print_checks"
                        string="Imprimir cheque"
                        type="object"
                        class="btn-secondary"
                        invisible="state in ('draft', 'canceled', 'rejected') or payment_method_code != 'own_checks'"/>
            </xpath>
        </field>
    </record>
</odoo>
